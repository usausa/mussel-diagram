<div @ref="Root" @attributes="AdditionalAttributes" class="@RootClass" tabindex="0" data-version="@Snapshot.Version">
    <div class="mussel-diagram-stage">
        <svg class="mussel-diagram-canvas">
            @Defs
            <g class="mussel-diagram-viewport">
                <g class="mussel-diagram-grid"></g>
                <g class="mussel-diagram-groups">@Groups</g>
                <g class="mussel-diagram-overlay-groups">@OverlayGroups</g>
                <g class="mussel-diagram-links">@Links</g>
                <g class="mussel-diagram-nodes">@Nodes</g>
            </g>
        </svg>
        <svg class="mussel-diagram-overlay">
            <g class="mussel-diagram-viewport"></g>
        </svg>
    </div>
</div>
