<div @ref="Root" @attributes="AdditionalAttributes" class="@RootClass" tabindex="0" data-version="@Snapshot.Version">
    <CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue>
    <div class="mussel-diagram-stage">
        <svg class="mussel-diagram-canvas">
            @Defs
            <g class="mussel-diagram-viewport">
                <g class="mussel-diagram-grid"></g>
                <g class="mussel-diagram-groups" @key="(generation, 0)">@Groups</g>
                <g class="mussel-diagram-overlay-groups" @key="(generation, 1)">@OverlayGroups</g>
                <g class="mussel-diagram-links" @key="(generation, 2)">@Links</g>
                <g class="mussel-diagram-nodes" @key="(generation, 3)">@Nodes</g>
                <g class="mussel-diagram-badges">@Badges</g>
            </g>
        </svg>
        <svg class="mussel-diagram-overlay">
            <g class="mussel-diagram-viewport"></g>
        </svg>
    </div>
</div>
