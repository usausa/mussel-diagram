<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <CodeAnalysisRuleSet>..\Analyzers.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <PropertyGroup>
    <PackageId>MusselDiagram</PackageId>
    <Title>MusselDiagram</Title>
    <Description>Diagram editor for Blazor with typed nodes, ports, links and groups, drawn as SVG</Description>
    <PackageTags>blazor diagram editor graph svg aws</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MusselDiagram.Core\MusselDiagram.Core.csproj" />
  </ItemGroup>

</Project>
