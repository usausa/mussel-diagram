<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <CodeAnalysisRuleSet>..\Analyzers.ruleset</CodeAnalysisRuleSet>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Example.Client\Example.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AwsIcon Include="..\AwsIcons\**\Arch_*_64.svg;..\AwsIcons\**\Res_*_48.svg;..\AwsIcons\**\Res_*_48_Light.svg;..\AwsIcons\**\*Group-Icons*\*_32.svg" Exclude="..\AwsIcons\__MACOSX\**" />
    <Content Include="@(AwsIcon)" Link="AwsIcons\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
