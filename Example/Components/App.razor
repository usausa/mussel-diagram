<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" href="data:," />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["_content/MusselDiagram/MusselDiagram.css"]" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />

    <div id="blazor-error-ui" data-nosnippet>
        予期しないエラーが起きました。
        <a href="." class="reload">再読み込み</a>
        <span class="dismiss">🗙</span>
    </div>

    <ReconnectModal />

    <script type="module" src="@Assets["js/reconnect.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode =>
        !HttpContext.AcceptsInteractiveRouting()
            ? null
            : HttpContext.Request.Cookies[RenderModes.CookieName] == RenderModes.WebAssembly
                ? InteractiveWebAssembly
                : InteractiveServer;
}
