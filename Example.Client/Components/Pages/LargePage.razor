@page "/large"

<PageTitle>MusselDiagram</PageTitle>

<div class="diagram-page">
    <div class="diagram-area">
        <ViewToolbar View="view" @bind-Mode="dragMode" Zoom="zoom" />
        <MusselDiagramView @ref="view" Diagram="diagram" GridVisible="@Grid.IsVisible()" GridStyle="DiagramGridStyle.Lines" BackgroundDragMode="@dragMode" ViewportChanged="OnViewportChanged" />
    </div>
</div>
