@page "/"

<PageTitle>MusselDiagram</PageTitle>

<div class="diagram-page diagram-with-palette">
    <aside class="diagram-sidebar">
        @if (view is not null)
        {
            <MusselDiagramPalette View="view" />
            <MusselDiagramDragSource View="view" Type="server" Value="Imported server" class="diagram-source">Imported server</MusselDiagramDragSource>
        }
    </aside>
    <div class="diagram-area">
        <ViewToolbar View="view" @bind-Mode="dragMode" Zoom="zoom" />
        <MusselDiagramView @ref="view" Diagram="diagram" GridVisible="@Grid.IsVisible()" GridStyle="DiagramGridStyle.Lines" BackgroundDragMode="@dragMode" ViewportChanged="OnViewportChanged" Moving="OnMoving" CommitMode="@(Wait ? DiagramCommitMode.Wait : DiagramCommitMode.Optimistic)">
            <TaskTemplate />
        </MusselDiagramView>
    </div>
</div>
