@page "/aws"

<PageTitle>MusselDiagram</PageTitle>

<div class="diagram-page diagram-with-palette">
    <aside class="diagram-sidebar">
        <div class="diagram-actions">
            <InputFile OnChange="ImportAsync" accept=".zip" class="diagram-import" data-action="import" />
        </div>
        @if (view is not null)
        {
            <MusselDiagramPalette View="view" />
        }
    </aside>
    <div class="diagram-area">
        <ViewToolbar View="view" @bind-Mode="dragMode" Zoom="zoom" />
        <MusselDiagramView @ref="view" Diagram="diagram" GridVisible="@Grid.IsVisible()" GridStyle="DiagramGridStyle.Lines" BackgroundDragMode="@dragMode" ViewportChanged="OnViewportChanged" class="example-aws" />
    </div>
</div>
